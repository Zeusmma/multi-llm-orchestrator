# One key per extra anthropic/openai-kind backend, named ORCH_<BACKEND_NAME_UPPERCASE>_API_KEY
ORCH_MYAPI_API_KEY=
ORCH_MYOPENAI_API_KEY=
# Optional
ORCH_WORK_ROOT=
ORCH_PREFIX_FILE=
DEEPSEEK_AGENT=
DEEPSEEK_LOG_DIR=
AGY_BIN=
